{
  "name": "poptavky",
  "version": "0.1.0",
  "private": true,
  "description": "A GitHub app to automatically export issues to a webpage.",
  "keywords": [
    "plugin",
    "github app",
    "automation"
  ],
  "homepage": "https://github.com/skaut/poptavky#readme",
  "bugs": {
    "url": "https://github.com/skaut/poptavky/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skaut/poptavky.git"
  },
  "author": "Marek Dědič",
  "type": "module",
  "scripts": {
    "collect": "node src/index.ts",
    "lint": "run-p -c --aggregate-output lint:*",
    "lint:eslint": "eslint --color",
    "lint:typecheck": "tsc --noEmit",
    "test": "vitest",
    "test-coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@octokit/core": "^7.0.7",
    "@octokit/plugin-rest-endpoint-methods": "^18.0.0",
    "ts-custom-error": "^3.3.1"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.0.1",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-package-json": "^1.7.1",
    "eslint-plugin-perfectionist": "^5.10.1",
    "eslint-plugin-prefer-arrow-functions": "^3.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "nock": "^14.0.17",
    "node-fetch": "^3.3.2",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "^26.0.0"
  }
}
