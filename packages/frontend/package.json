{
  "name": "poptavky-fe",
  "version": "0.1.0",
  "private": true,
  "description": "A frontend to display GitHub issues in a webpage",
  "keywords": [
    "react",
    "issues"
  ],
  "homepage": "https://itpoptavky.skaut.cz",
  "bugs": {
    "url": "https://github.com/skaut/poptavky/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skaut/poptavky.git"
  },
  "type": "module",
  "scripts": {
    "prebuild": "npm run clean",
    "build": "vite build",
    "check": "FORCE_COLOR=1 run-p -c --aggregate-output check:*",
    "check:js-compat": "es-check es2022 --module --checkFeatures 'dist/**/*.js'",
    "clean": "rimraf dist/*",
    "lint": "FORCE_COLOR=1 run-p -c --aggregate-output lint:*",
    "lint:eslint": "eslint",
    "lint:typecheck": "tsc --noEmit",
    "start": "vite",
    "test": "vitest run --coverage",
    "test-accept": "vitest run --update",
    "test-watch": "vitest"
  },
  "browserslist": [
    "baseline 2022"
  ],
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "react": "^19.0.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.1",
    "remark-gfm": "^4.0.1",
    "string-to-color": "^2.2.2",
    "swr": "^2.5.1"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint-react/eslint-plugin": "^5.19.1",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.5.1",
    "@types/react-dom": "^19.3.0",
    "@types/react-test-renderer": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/eslint-plugin": "^1.6.27",
    "es-check": "^9.7.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-compat": "^7.0.2",
    "eslint-plugin-package-json": "^1.8.1",
    "eslint-plugin-perfectionist": "^5.11.0",
    "eslint-plugin-prefer-arrow-functions": "^3.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.0",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
