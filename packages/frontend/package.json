{
  "name": "poptavky-fe",
  "version": "0.1.0",
  "private": true,
  "description": "A frontend to display GitHub issues in a webpage",
  "keywords": [
    "react",
    "issues"
  ],
  "homepage": "https://itpoptavky.skaut.cz",
  "bugs": {
    "url": "https://github.com/skaut/poptavky/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skaut/poptavky.git"
  },
  "type": "module",
  "scripts": {
    "prebuild": "npm run clean",
    "build": "vite build",
    "check": "FORCE_COLOR=1 run-p -c --aggregate-output check:*",
    "check:js-compat": "es-check es2022 --module --checkFeatures 'dist/**/*.js'",
    "clean": "rimraf dist/*",
    "lint": "FORCE_COLOR=1 run-p -c --aggregate-output lint:*",
    "lint:eslint": "eslint --color",
    "lint:typecheck": "tsc --noEmit",
    "start": "vite",
    "test": "vitest run --coverage",
    "test-accept": "vitest run --update",
    "test-watch": "vitest"
  },
  "browserslist": [
    "baseline 2022"
  ],
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "react": "^19.0.0",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.0",
    "remark-gfm": "^4.0.1",
    "string-to-color": "^2.2.2",
    "swr": "^2.5.1"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/js": "^9.39.2",
    "@eslint/json": "^2.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.4.0",
    "@types/react-dom": "^19.2.5",
    "@types/react-test-renderer": "^19.1.0",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/eslint-plugin": "^1.6.27",
    "es-check": "^9.6.4",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-compat": "^7.0.2",
    "eslint-plugin-package-json": "^1.7.1",
    "eslint-plugin-perfectionist": "^5.10.1",
    "eslint-plugin-prefer-arrow-functions": "^3.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
